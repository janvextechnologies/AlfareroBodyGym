# =============================================================================
#  ALFARERO BODY GYM — Variables de entorno (ejemplo)
# -----------------------------------------------------------------------------
#  Copia este archivo a ".env.local" y rellena los valores reales.
#  NUNCA subas ".env.local" al repositorio ni compartas los secretos.
# =============================================================================

# --- Base de datos (Supabase PostgreSQL + Drizzle) ----------------------------
# URL con pooler (puerto 6543) para la app en ejecución.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# URL directa (puerto 5432) para migraciones de Drizzle. Opcional si usas la misma.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Supabase Storage ---------------------------------------------------------
# URL pública del proyecto (segura para el cliente).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Clave de servicio: SOLO servidor. Nunca la expongas con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"
# Bucket público donde se guardan las imágenes del gimnasio.
SUPABASE_STORAGE_BUCKET="gym-media"

# --- Autenticación del administrador -----------------------------------------
ADMIN_USERNAME="admin"
# Hash bcrypt de la contraseña. Genera con: npm run hash-password
# IMPORTANTE: los "$" del hash deben ir escapados con "\" porque Next los
# interpreta como variables y dejaría el valor vacío.
# El script npm run hash-password ya imprime la línea lista para pegar.
ADMIN_PASSWORD_HASH=\$2b\$12\$REEMPLAZA_ESTO_POR_EL_HASH_GENERADO
# Secreto para firmar la sesión (mínimo 32 caracteres aleatorios).
SESSION_SECRET="cambia-esta-cadena-por-una-aleatoria-de-32-o-mas-caracteres"
# Duración de la sesión en horas (opcional, por defecto 8).
SESSION_TTL_HOURS="8"
